# Database Environment Configuration
# Example configuration for SQL Server database connection
# Copy this file to .env and fill in with your real credentials
# Database server address
DB_ADRESS=localhost
# Database user
DB_USER=example_user
# Database password
DB_PASSWORD=example_password_123
# Database name
DB_NAME_SERVER_NAME=example_database
# ODBC Driver for SQL Server
# Common options:
# - ODBC Driver 17 for SQL Server
# - ODBC Driver 18 for SQL Server
# - SQL Server
DB_DRIVER=ODBC Driver 17 for SQL Server
