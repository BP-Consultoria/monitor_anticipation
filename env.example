# Database Environment Configuration
# Example configuration for SQL Server database connection
# Copy this file to .env and fill in with your real credentials
# Database server address
DB_ADRESS=localhost
# Database user
DB_USER=example_user
# Database password
DB_PASSWORD=example_password_123
# Database name
DB_NAME_SERVER_NAME=example_database
# ODBC Driver for SQL Server
# Common options:
# - ODBC Driver 17 for SQL Server
# - ODBC Driver 18 for SQL Server
# - SQL Server
DB_DRIVER=ODBC Driver 17 for SQL Server

# Network Path Configuration
# Server network path (the actual server/share you want to access)
# Examples:
# - Windows format: \\192.168.0.95\dados
# - Linux format: //192.168.0.95/dados (or \\192.168.0.95\dados - will be converted)
NETWORK_PATH=\\192.168.0.95\dados
# Network credentials (optional - if server requires authentication)
NETWORK_USER=your_username
NETWORK_PASSWORD=your_password
# Linux mount point (local directory where the network share will be mounted)
# This is NOT the server path, but a LOCAL directory on your Linux machine
# Examples: /mnt/network_share, /home/username/network_share, /media/network_share
NETWORK_MOUNT_POINT=/mnt/network_share
